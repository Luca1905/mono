{
	"name": "mono",
	"module": "src/index.tsx",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"dev": "bun run --watch src/index.tsx",
		"check:unsafe": "biome check --write --unsafe .",
