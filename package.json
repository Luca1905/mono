		"prepare": "husky",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@types/bun": "latest",
		"concurrently": "9.2.1",
		"husky": "^9.1.7",
		"lint-staged": "16.4.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@opentui/core": "^0.1.99",
		"@opentui/react": "^0.1.99",
		"react": "^19.2.4"
	}
}
